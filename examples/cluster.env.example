# Example only — copy values are placeholders.
# Real cluster.env is written under state/ (gitignored) by the installer.

CLUSTER_NAME="my-rosa-01"
AWS_PROFILE="rhdp_demo"
AWS_REGION="ap-northeast-1"
AWS_ACCOUNT_ID="123456789012"
OPENSHIFT_VERSION="4.22.22"
NETWORK_TYPE="public"
INSTANCE_TYPE="m6a.xlarge"
MIN_REPLICAS="2"
MAX_REPLICAS="2"
VPC_CIDR="10.50.0.0/16"
ENABLE_AUTONODE="true"
# Override sibling repos if they are not next to this installer:
# VALIDATED_PATTERN_DIR="/path/to/validated-pattern-terraform-rosa"
# SNO_GUIDE_DIR="/path/to/rhoai-sno-setup-guide"
# TOOLKIT_DIR="/path/to/RHOAI-Toolkit"
