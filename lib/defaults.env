# Defaults for rosa-rhoai-installer (macOS / RHDP-style empty AWS account)
# Override any value by exporting it before running install.sh

DEFAULT_REGION="ap-northeast-1"
DEFAULT_OPENSHIFT_VERSION="4.22.22"
DEFAULT_NETWORK_TYPE="public"
DEFAULT_AWS_PROFILE="rhdp_demo"
# Multi-AZ VPC/subnets by default (GPU capacity often only in some AZs, e.g. Tokyo 1c)
DEFAULT_MULTI_AZ="true"
# Platform floor only — RHOAI capacity comes from Phase-2 Karpenter CPU/GPU NodePools
# With multi_az=true these are per-AZ (exactly 1× m6a.xlarge per AZ ≈ 3 total)
DEFAULT_INSTANCE_TYPE="m6a.xlarge"
DEFAULT_MIN_REPLICAS="1"
DEFAULT_MAX_REPLICAS="1"
DEFAULT_VPC_CIDR="10.50.0.0/16"
DEFAULT_ENABLE_AUTONODE="true"

# Sibling directories: parent of rosa-rhoai-installer/ (override with env if layout differs)
WORKSPACE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
VALIDATED_PATTERN_DIR="${VALIDATED_PATTERN_DIR:-$WORKSPACE_ROOT/validated-pattern-terraform-rosa}"
SNO_GUIDE_DIR="${SNO_GUIDE_DIR:-$WORKSPACE_ROOT/rhoai-sno-setup-guide}"
TOOLKIT_DIR="${TOOLKIT_DIR:-$WORKSPACE_ROOT/RHOAI-Toolkit}"

# Sibling repos: install.sh clones if missing; re-pull with: git -C <dir> pull
VALIDATED_PATTERN_GIT_URL="${VALIDATED_PATTERN_GIT_URL:-https://github.com/rh-mobb/validated-pattern-terraform-rosa.git}"
VALIDATED_PATTERN_GIT_REF="${VALIDATED_PATTERN_GIT_REF:-main}"
SNO_GUIDE_GIT_URL="${SNO_GUIDE_GIT_URL:-https://github.com/jingggg-wenn/rhoai-sno-setup-guide.git}"
TOOLKIT_GIT_URL="${TOOLKIT_GIT_URL:-https://github.com/gymnatics/RHOAI-Toolkit.git}"

OCM_TOKEN_FILE="${OCM_TOKEN_FILE:-$HOME/.config/ocm/offline-token}"
RHOAI_CHANNEL="stable-3.5"
