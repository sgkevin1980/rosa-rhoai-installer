# Generated by rosa-rhoai-installer — do not commit secrets
# Cluster: __CLUSTER_NAME__

cluster_name = "__CLUSTER_NAME__"

openshift_version = "__OPENSHIFT_VERSION__"

network_type = "public"
zero_egress  = false
private      = false
region       = "__REGION__"
vpc_cidr     = "__VPC_CIDR__"

multi_az = false

# Platform floor — ON-DEMAND only
default_instance_type = "__INSTANCE_TYPE__"
default_min_replicas  = __MIN_REPLICAS__
default_max_replicas  = __MAX_REPLICAS__

# No ROSA additional pools — AI/GPU via Karpenter day-2
additional_machine_pools = {}

# Empty cluster — Day-2 RHOAI install
enable_gitops_bootstrap = false
enable_cluster_admin    = true

# AutoNode (Karpenter)
enable_autonode = true

enable_persistent_dns_domain        = false
enable_cert_manager_iam             = false
enable_termination_protection       = false
enable_cloudwatch_logging           = false
enable_control_plane_log_forwarding = false
enable_audit_logging                = false
enable_timing                       = true
